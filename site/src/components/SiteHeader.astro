---
import { ASSISTANT_URL, HOME_URL, MOVES_INDEX_URL } from "../lib/urls";

const pathname = Astro.url.pathname;
const isHome = pathname === HOME_URL;
const isMoves = pathname.startsWith(MOVES_INDEX_URL);
const isAssistant = pathname.startsWith(ASSISTANT_URL);
---

<header class="site-header">
  <a class="site-title" href={HOME_URL}>Dungeon World Companion</a>
  <nav class="site-nav" aria-label="Main">
    <a href={HOME_URL} aria-current={isHome ? "page" : undefined}>Contents</a>
    <a href={MOVES_INDEX_URL} aria-current={isMoves ? "page" : undefined}>Moves</a>
    <a href={ASSISTANT_URL} aria-current={isAssistant ? "page" : undefined}>Assistant</a>
  </nav>
</header>
