# dw-companion environment variables.
# Copy to .env for local development (.env is git-ignored). Never commit real values.
# Every variable the code reads must be listed here, with an empty value and a comment
# naming the spec that introduced it. Secrets in deployment come from Secret Manager (spec 011).

# Model routing (handoff 4.2) — consumed from spec 007. Model names only, never hardcoded.
MODEL_ROUTER=
MODEL_CLASSIFIER=
MODEL_ANSWER=
# Must equal "embedding_model" in data/index/manifest.json (rebuild the index after changing it).
MODEL_EMBEDDINGS=

# OpenRouter (spec 007): one key for chat models and embeddings.
OPENROUTER_API_KEY=

# Langfuse tracing (spec 007). Leave both keys empty to disable tracing locally.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional; defaults to https://cloud.langfuse.com
LANGFUSE_BASE_URL=

# Chat API guardrails (spec 008). Leave empty for the default in brackets.
# Accepted /api/chat requests per client IP per rolling minute [5].
CHAT_RATE_PER_MINUTE=
# Accepted /api/chat requests per client IP per UTC day [50].
CHAT_RATE_PER_DAY=
# Global LLM spend cap per UTC day, in USD [1.00]. In-memory per process (see docs/decisions.md).
CHAT_DAILY_BUDGET_USD=
# X-Forwarded-For entries added by trusted proxies, counted from the right [0 = use the socket peer].
CHAT_TRUSTED_PROXY_HOPS=
